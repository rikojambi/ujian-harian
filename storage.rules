rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isTeacher() {
      return role() == 'teacher' || isAdmin();
    }

    match /media/{teacherId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isTeacher()
        && request.auth.uid == teacherId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*|video/.*|application/pdf');
      allow delete: if isAdmin() || (isTeacher() && request.auth.uid == teacherId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
