#Firebase Web App configuration (Firebase console -> Project settings -> Your apps)
#Semua variabel yang dibutuhkan Firebase client. Tidak ada rahasia admin di sini.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

#Opsional: gunakan emulator Firebase lokal
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=http://127.0.0.1:8085
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099

#Mode penyimpanan media: external (Google Drive / CDN / server sekolah) atau local (IndexedDB)
VITE_MEDIA_MODE=external

#Konfigurasi batas media (bytes / detik)
VITE_MAX_IMAGE_BYTES=1572864
VITE_MAX_AUDIO_BYTES=5242880
VITE_MAX_VIDEO_BYTES=20971520
VITE_MAX_VIDEO_SECONDS=60

#Kredensial Admin SDK (HANYA untuk skrip Node, JANGAN pakai prefiks VITE_)
#Isi SALAH SATU: path ke file service account JSON atau JSON service account mentah.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

#Admin awal (dipakai oleh npm run bootstrap:admin)
BOOTSTRAP_ADMIN_EMAIL=admin@ujianharian.local
BOOTSTRAP_ADMIN_PASSWORD=ganti-dengan-kata-sandi-kuat
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_FORCE_PASSWORD=false
