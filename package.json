{
  "name": "ujian-harian",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ujian-harian \"node --test tests/rules.test.mjs\"",
    "icons": "node scripts/generate-icons.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "users:create": "node scripts/manage-users.mjs create",
    "users:list": "node scripts/manage-users.mjs list",
    "users:role": "node scripts/manage-users.mjs role",
    "users:password": "node scripts/manage-users.mjs password",
    "users:delete": "node scripts/manage-users.mjs delete",
    "seed:firestore": "node scripts/seed-firestore.mjs",
    "backup:firestore": "node scripts/backup-firestore.mjs",
    "restore:firestore": "node scripts/restore-firestore.mjs",
    "score": "node scripts/score-results.mjs",
    "check": "npm run test && npm run test:rules && npm run build"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "firebase": "^11.10.0",
    "idb": "^8.0.2",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "xlsx": "^0.18.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.6.1",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.9.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.4"
  }
}
